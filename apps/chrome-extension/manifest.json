{
  "manifest_version": 3,
  "name": "After-thinking Capture",
  "version": "0.9.1",
  "description": "Capture, annotate and reuse AI conversations as thinking assets. 擷取、標記並重複利用 AI 對話，保存可追溯的思考資產。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "擷取這段對話",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://*.oaiusercontent.com/*",
    "https://assets.grok.com/*"
  ],
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ]
}
