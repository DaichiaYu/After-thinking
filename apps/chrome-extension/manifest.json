{
  "manifest_version": 3,
  "name": "After-thinking Capture",
  "version": "0.2.0",
  "description": "把 ChatGPT 或 Claude 的對話擷取成 After-thinking 的原文檔，並上傳到你自己的私人 GitHub 倉庫。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "擷取這段對話",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "options_page": "options.html"
}